// Prisma schema for NextGen IT Services

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ContactStatus {
  PENDIENTE
  REVISADO
  RESPONDIDO
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id        Int           @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String?
  mensaje   String
  estado    ContactStatus @default(PENDIENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
