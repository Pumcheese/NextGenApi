---
import MainLayout from "../../../layouts/MainLayout.astro";
import { copy, languages, type Language } from "../../../i18n/translations";

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const t = copy[lang];
---

<MainLayout lang={lang} title={t.nav.services}>
  <h1 class="text-3xl font-bold">{t.nav.services}</h1>
  <ul class="mt-4 list-disc pl-5">
    <li>Cloud & DevOps</li>
    <li>Modernización de aplicaciones</li>
    <li>Automatización de procesos</li>
  </ul>
</MainLayout>
