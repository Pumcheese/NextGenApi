---
import MainLayout from "../../../layouts/MainLayout.astro";
import { copy, languages, type Language } from "../../../i18n/translations";

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const t = copy[lang];
---

<MainLayout lang={lang} title={t.nav.projects}>
  <h1 class="text-3xl font-bold">{t.nav.projects}</h1>
  <p class="mt-4">Caso de éxito #1: Migración de infraestructura on-premise a cloud.</p>
</MainLayout>
