---
import MainLayout from "../../../layouts/MainLayout.astro";
import { resolveLang } from "../../../lib/i18n";
import { getSiteCopy } from "../../../lib/site";

const lang = resolveLang(Astro.params.lang);
const copy = getSiteCopy(lang);
const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "rate-limit" ? copy.admin.rateLimitError : error;
---

<MainLayout lang={lang} title={copy.admin.loginTitle}>
  <section class="section-vermont">
    <div class="container-vermont max-w-2xl">
      <div class="surface-panel p-8 md:p-12">
        <p class="section-eyebrow">{copy.nav.admin}</p>
        <h1 class="section-heading max-w-2xl text-4xl md:text-5xl">{copy.admin.loginTitle}</h1>
        <p class="section-intro max-w-xl">{copy.admin.loginDescription}</p>
        {errorMessage && (
          <div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
            {errorMessage}
          </div>
        )}
        <form
          action="/api/admin/login"
          method="post"
          class="mt-8 space-y-5 js-pending-form"
          data-pending-label={copy.admin.loginPendingLabel}
        >
          <input type="hidden" name="lang" value={lang} />
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-slate-700">{copy.form.email}</span>
            <input class="form-field" type="email" name="email" required maxlength="160" autocomplete="email" />
          </label>
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-slate-700">{copy.admin.passwordLabel}</span>
            <input class="form-field" type="password" name="password" required minlength="8" autocomplete="current-password" />
          </label>
          <button class="btn-primary" type="submit" data-default-label={copy.admin.loginTitle}>
            {copy.admin.loginTitle}
          </button>
        </form>
        <a href={`/${lang}/admin/recover`} class="mt-5 inline-flex text-sm font-medium text-sky-700 hover:text-sky-600">
          {copy.admin.recoveryLinkLabel}
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const forms = document.querySelectorAll(".js-pending-form");

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement)) continue;

    form.addEventListener("submit", () => {
      const submitButton = form.querySelector('button[type="submit"]');

      if (!(submitButton instanceof HTMLButtonElement)) return;

      submitButton.disabled = true;
      submitButton.textContent = form.dataset.pendingLabel || submitButton.dataset.defaultLabel || submitButton.textContent;
    });
  }
</script>
